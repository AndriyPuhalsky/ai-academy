# Що НЕ роздавати з сайту.
# Cloudflare Workers має [assets] directory = "." — тобто без цього файлу
# публікується весь репозиторій. Синтаксис як у .gitignore.
# Шлях у корені assets-директорії = корінь репозиторію.

# Приватна майстерня: стратегія, ідеї, дизайн-макети
dev/
deploy-guide.local.html

# Службові файли розробки
# ⚠ .git/ ОБОВʼЯЗКОВО: wrangler читає його як assets (directory = "."), тому
#    без цього рядка (а) git-пак > 25 MiB валить білд «Asset too large» —
#    саме так білди падали з 2026-09-07, і (б) /.git/config віддавався з
#    живого домену з кодом 200. Не видаляти.
.git/
.claude/
.mcp.json
CLAUDE.md
wrangler.toml
.gitignore
.assetsignore
.DS_Store

